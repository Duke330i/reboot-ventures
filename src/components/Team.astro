---
const partners = [
  {
    name: 'Vib Prasad',
    title: 'Co-Founder & Managing Partner',
    photo: '/images/team/Vib_Prasad.png',
    bio: "Vib brings more than 25 years of experience building and leading businesses across technology, commerce, and financial services. He was co-founder and co-CEO of CreateMe and founded CourtLink, later acquired by LexisNexis. He also held P&L responsibility for a $500M e-commerce business at 1-800-Flowers and led global product management for Mastercard's digital wallet. Through Reboot, he brings that experience to advising CEOs and leadership teams on strategy, scaling, organizational effectiveness, and technology decisions.",
  },
  {
    name: 'Jason Wrubel',
    title: 'Co-Founder & Managing Partner',
    photo: '/images/team/Jason_Wrubel.jpg',
    bio: 'Jason brings more than 25 years of experience helping companies navigate growth, complexity, and change as both a consultant and operating executive. He founded and led Virsent, an operations and technology consulting firm, and served as SVP of Operations at CreateMe, where he led operations and client delivery as the company scaled globally. Today, through Reboot, he advises and coaches CEOs and senior executives on strategy, leadership, organizational effectiveness, and execution, drawing on his operating experience and more than a decade facilitating executive peer groups at Venwise.',
  },
];
const companies = [
  'CreateMe',
  'CourtLink (acquired by LexisNexis)',
  'Virsent',
  '1-800-Flowers',
  'Mastercard',
  'Duane Reade',
  'Accenture',
];
---
<section id="team" class="bg-slate-50 scroll-mt-16">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-20 lg:py-[88px] flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-[760px]">
      <span class="text-[13px] font-bold tracking-[1.5px] uppercase text-emerald-700">Who you'll work with</span>
      <h2 class="m-0 text-3xl lg:text-[42px] leading-tight font-extrabold">Senior partners lead. Specialists join when needed.</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      {partners.map((p) => (
        <div class="bg-white border border-slate-200 rounded-[10px] p-7 flex flex-col sm:flex-row gap-5 items-start">
          <img src={p.photo} alt={p.name} width="88" height="88" loading="lazy" class="w-[88px] h-[88px] rounded-full object-cover shrink-0" />
          <div class="flex flex-col gap-2">
            <h3 class="m-0 text-xl font-bold">{p.name}</h3>
            <span class="text-sm font-semibold text-emerald-700">{p.title}</span>
            <p class="m-0 text-[15px] leading-relaxed text-slate-600">{p.bio}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="flex flex-col gap-3 pt-2 max-w-[960px]">
      <h3 class="m-0 text-[17px] font-bold">Our specialist network</h3>
      <p class="m-0 text-[15px] leading-relaxed text-slate-600">We bring in experienced operators and subject-matter experts when an engagement requires specialized capabilities.</p>
      <p class="m-0 text-[15px] leading-relaxed text-slate-600">Our network includes expertise in data architecture, AI infrastructure, product and engineering, product strategy, strategic finance, go-to-market, cybersecurity, and strategic communications.</p>
      <p class="m-0 text-[15px] leading-relaxed text-slate-600">Each specialist works as part of a coordinated Reboot engagement led by a senior partner.</p>
    </div>
    <div class="flex flex-col gap-2.5 pt-4 border-t border-slate-200">
      <span class="text-[13px] font-bold tracking-wider uppercase text-slate-500">Where our partners have built and led</span>
      <p class="m-0 text-base leading-loose font-semibold text-slate-700">{companies.join(' · ')}</p>
    </div>
  </div>
</section>
