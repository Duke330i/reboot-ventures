---
const clients = ["Bloomingdale's", "Google", "Mastercard", "Citi", "Atlassian", "Jackpocket", "Counterpart", "WayUp", "Philo", "CreateMe", "Eyeview", "LearnVest", "Curacity", "Puls", "Pharos", "Nicus", "Trail of Bits", "Medal TV", "BrandYourself", "ScaleGrid", "SHURE", "Sumeru", "COGEP", "Samsar Resources", "Alice", "Arrow IA", "Identity Automation", "Closed Loop Partners"];
---
<section id="social-proof" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-extrabold mb-14" style="color:#0F2044">Clients Who Were Stuck. Now Moving.</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      <div class="rounded-xl p-7 border-2" style="border-color:#0F2044; background:#F8FAFC">
        <div class="text-xs font-bold tracking-widest uppercase mb-4 px-3 py-1 rounded-full text-white w-fit" style="background:#059669">Case Study</div>
        <h3 class="text-lg font-bold mb-1" style="color:#0F2044">B2B Software Company, ~45 Employees</h3>
        <p class="text-xs font-semibold text-slate-400 mb-4">AI Operationalization</p>
        <div class="space-y-3 text-sm text-slate-600">
          <div><span class="font-semibold" style="color:#0F2044">Challenge:</span> A B2B software company needed to operationalize AI across its internal marketing and communications workflows — and then scale that model org-wide.</div>
          <div><span class="font-semibold" style="color:#0F2044">Engagement:</span> We assembled a purpose-built team with AI automation, product, and change management expertise. Over 6–8 weeks, we designed and deployed an AI-enabled SMS marketing stack.</div>
          <div class="pt-2 border-t border-slate-200"><span class="font-bold" style="color:#059669">Result:</span> Moved from isolated AI experiments to an org-wide AI operating model. Efficiency gains measurable in the first quarter.</div>
        </div>
      </div>
      <div class="rounded-xl p-7 border-2" style="border-color:#0F2044; background:#F8FAFC">
        <div class="text-xs font-bold tracking-widest uppercase mb-4 px-3 py-1 rounded-full text-white w-fit" style="background:#059669">Case Study</div>
        <h3 class="text-lg font-bold mb-1" style="color:#0F2044">Beauty Technology Company, ~1,000 Employees</h3>
        <p class="text-xs font-semibold text-slate-400 mb-4">MarTech Stack Rationalization</p>
        <div class="space-y-3 text-sm text-slate-600">
          <div><span class="font-semibold" style="color:#0F2044">Challenge:</span> A fast-growing beauty tech company was overspending on a fragmented MarTech stack with significant redundancy.</div>
          <div><span class="font-semibold" style="color:#0F2044">Engagement:</span> We mapped the full MarTech landscape, evaluated each system against actual usage data, and identified significant redundant vendor spend.</div>
          <div class="pt-2 border-t border-slate-200"><span class="font-bold" style="color:#059669">Result:</span> Identified substantial annual savings. Created a streamlined MarTech roadmap aligned to growth objectives.</div>
        </div>
      </div>
    </div>
    <div class="rounded-2xl p-8 mb-14 grid grid-cols-2 md:grid-cols-4 gap-6" style="background:#0F2044">
      <div class="text-center"><div class="text-3xl lg:text-4xl font-extrabold text-white mb-1">25+</div><div class="text-xs font-medium text-slate-300">Years Avg. Partner Experience</div></div>
      <div class="text-center"><div class="text-3xl lg:text-4xl font-extrabold text-white mb-1">130+</div><div class="text-xs font-medium text-slate-300">C-Level Executives Advised</div></div>
      <div class="text-center"><div class="text-3xl lg:text-4xl font-extrabold text-white mb-1">2</div><div class="text-xs font-medium text-slate-300">Portfolio Companies to IPO at $2B+</div></div>
      <div class="text-center"><div class="text-3xl lg:text-4xl font-extrabold text-white mb-1">Fortune 100</div><div class="text-xs font-medium text-slate-300">to Series B Client Range</div></div>
    </div>
    <div><h3 class="text-lg font-bold mb-6 text-center" style="color:#0F2044">Companies We've Worked With</h3>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
        {clients.map((client) => (
          <span class="text-sm font-medium text-slate-500 py-1">{client}</span>
        ))}
      </div>
    </div>
  </div>
</section>
