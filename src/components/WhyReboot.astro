---
const reasons = [
  {
    title: 'Operating experience',
    body: 'Our partners have led businesses and teams and understand the tradeoffs and realities of running an organization.',
  },
  {
    title: 'Diagnosis across boundaries',
    body: "We look across strategy, people, processes, ownership, and technology to identify what's actually constraining progress.",
  },
  {
    title: 'The right expertise, one relationship',
    body: 'Senior partners lead the work and bring in trusted specialists when the problem calls for them. Clients have one coordinated relationship and clear accountability.',
  },
  {
    title: 'From decisions to execution',
    body: 'We focus on practical recommendations, clear ownership, and actionable next steps. Where needed, we help lead and oversee execution through client teams and partners.',
  },
];
---
<section id="why-reboot" class="bg-white scroll-mt-16">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-20 lg:py-[88px] flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-[760px]">
      <span class="text-[13px] font-bold tracking-[1.5px] uppercase text-emerald-700">Why Reboot</span>
      <h2 class="m-0 text-3xl lg:text-[42px] leading-tight font-extrabold">Judgment from people who have done the job.</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {reasons.map((r) => (
        <div class="flex flex-col gap-2">
          <h3 class="m-0 text-lg font-bold">{r.title}</h3>
          <p class="m-0 text-base leading-relaxed text-slate-600">{r.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
