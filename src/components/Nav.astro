---
const links = [
  { href: '#situations', label: 'When to call us' },
  { href: '#help', label: 'How we help' },
  { href: '#work', label: 'Our work' },
  { href: '#team', label: 'Team' },
];
---
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200">
  <nav aria-label="Primary" class="max-w-[1200px] mx-auto px-4 sm:px-6 flex items-center justify-between gap-4 h-16">
    <a href="/" class="flex items-center shrink-0">
      <img src="/logo.png" alt="Reboot Ventures" width="389" height="210" class="h-11 w-auto object-contain" />
    </a>
    <div class="flex items-center gap-6">
      {links.map((l) => (
        <a href={l.href} class="hidden md:inline text-[15px] text-slate-700 hover:text-[#0F2044]">{l.label}</a>
      ))}
      <a href="#contact" class="text-sm sm:text-[15px] font-semibold px-4 py-2.5 rounded-md text-white bg-[#0F2044] hover:bg-[#1E3A64]">Start a conversation</a>
    </div>
  </nav>
</header>
