---
const phases = [
  { num: "0", label: "Pre-Kickoff", time: "2–3 Days", body: "Before we start the clock, we do our homework. We review your existing tech stack, strategy docs, org charts, and any prior AI efforts. By Day 1 of Discovery, we already know your business." },
  { num: "1", label: "Discovery", time: "Weeks 1–4", body: "We conduct stakeholder interviews, map your data flows and systems, and assess AI readiness across five dimensions: organizational structure, data infrastructure, operations and security, revenue and customer experience, and technology stack.", deliverable: "AI Readiness Report + Opportunity Map" },
  { num: "2", label: "Opportunity Mapping", time: "Weeks 5–6", body: "We score every identified opportunity against six factors: business impact, implementation effort, time-to-value, risk and governance complexity, data readiness, and adoption readiness." },
  { num: "3", label: "Prioritization & Roadmap", time: "Week 7", body: "We consolidate findings into a phased AI roadmap with clear ownership, resource requirements, and milestone definitions. We provide an explicit Build vs. Buy vs. Partner recommendation for each initiative." },
  { num: "4", label: "Readout", time: "Week 8", body: "We present the full roadmap to your executive team and board-level stakeholders. The deliverable is presentation-ready, decision-ready, and built to survive a tough Q&A.", deliverable: "Full AI Roadmap + Board-Ready Presentation" }
];
---
<section id="what-we-do" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-5" style="color:#0F2044">Our Engagement Model: From Assessment to Impact</h2>
      <p class="text-lg text-slate-600 leading-relaxed">We don't parachute in with a generic strategy deck. We assemble the right team for your challenge, learn your business thoroughly, and deliver a clear, prioritized roadmap — with transparent pricing and no surprises.</p>
    </div>
    <div class="space-y-4 mb-16">
      {phases.map((phase) => (
        <div class="flex gap-6 p-6 rounded-xl border border-slate-100 bg-white">
          <div class="flex-shrink-0 w-14 h-14 rounded-full flex items-center justify-center font-black text-xl text-white" style="background:#0F2044">{phase.num}</div>
          <div class="flex-1">
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 mb-2">
              <h3 class="text-lg font-bold" style="color:#0F2044">Phase {phase.num}: {phase.label}</h3>
              <span class="text-sm font-semibold px-3 py-0.5 rounded-full text-white w-fit" style="background:#059669">{phase.time}</span>
            </div>
            <p class="text-slate-600 leading-relaxed text-sm">{phase.body}</p>
            {phase.deliverable && <p class="mt-2 text-sm font-semibold" style="color:#059669">✓ Deliverable: {phase.deliverable}</p>}
          </div>
        </div>
      ))}
    </div>
    <div class="rounded-2xl p-8 text-center" style="background:#059669">
      <h3 class="text-xl font-bold text-white mb-2">Transparent, Fixed-Fee Pricing</h3>
      <p class="text-white/90 text-sm max-w-2xl mx-auto mb-4">Every engagement is priced at a fixed fee — Phases 0 through 4, regardless of scope. No hourly rates, no scope creep surprises, no change orders for the work we said we'd do.</p>
      <a href="#contact" class="inline-flex items-center px-6 py-3 bg-white rounded-lg text-sm font-semibold" style="color:#0F2044">Discuss Availability & Pricing →</a>
    </div>
  </div>
</section>
