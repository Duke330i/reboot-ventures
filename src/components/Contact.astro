---
const bookingUrl = 'https://calendar.app.google/UFqusQDgL7WHpCXU9';
---
<section id="contact" class="bg-[#0F2044] text-white scroll-mt-16">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-20 lg:py-[88px] flex flex-col lg:flex-row gap-10 lg:items-center lg:justify-between">
    <div class="flex flex-col gap-3.5 max-w-[720px]">
      <h2 class="m-0 text-3xl lg:text-[42px] leading-tight font-extrabold">What's the problem you're working on?</h2>
      <p class="m-0 text-lg leading-relaxed text-slate-300">Strategy, leadership, execution, AI, or an important decision you're weighing. Let's talk about what you're trying to solve and whether Reboot can help.</p>
    </div>
    <div class="flex flex-col gap-3.5 lg:w-[300px] shrink-0">
      <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="px-6 py-4 rounded-md bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-center">Book a 30-minute call</a>
      <a href="mailto:info@rebootventures.co" class="text-emerald-300 hover:text-emerald-200 text-center text-[15px]">info@rebootventures.co</a>
    </div>
  </div>
  <footer class="max-w-[1200px] mx-auto px-4 sm:px-6 py-6 border-t border-[#1E3A64] flex flex-wrap gap-4 justify-between text-[13px] text-slate-400">
    <span>© 2026 Reboot Ventures LLC</span>
    <span>
      <a href="tel:+13015261780" class="hover:text-white">(301) 526-1780</a>
      <span aria-hidden="true"> · </span>
      <a href="https://www.linkedin.com/company/reboot-ventures-llc/" target="_blank" rel="noopener noreferrer" class="hover:text-white">LinkedIn</a>
    </span>
  </footer>
</section>
